DATABASE_URL=postgresql://localhost:5432/mnemonify_dev
CONTENT_BASE_URL=http://localhost:3001
PORT=3001

# Optional Cloudflare R2 storage. Leave these blank/omitted for local disk.
# R2_PUBLIC_URL must be the public bucket URL (r2.dev) or Cloudflare-fronted
# custom domain used to serve uploaded objects, without a trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mnemonify-dev
R2_PUBLIC_URL=

# Optional Resend email delivery. Leave RESEND_API_KEY blank for the existing
# local SMTP/auth_email_outbox fallback. RESEND_FROM must use the verified
# sending domain when the Resend backend is active.
RESEND_API_KEY=
RESEND_FROM=noreply@mail.mnemonify.org
